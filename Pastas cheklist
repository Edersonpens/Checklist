# =====================================================
# SISTEMA DE CRIACAO DE CHECKLIST
# COM LOG COMPLETO
# =====================================================

Clear-Host

# =========================
# CABECALHO
# =========================
Write-Host "==========================================" -ForegroundColor Cyan
Write-Host "      SISTEMA DE CHECKLIST"
Write-Host "==========================================" -ForegroundColor Cyan
Write-Host ""

# =========================
# FUNCAO LOG
# =========================
function Escrever-Log {
    param (
        [string]$Texto
    )

    $hora = Get-Date -Format "dd-MM-yyyy HH:mm:ss"
    $linha = "$hora - $Texto"

    Add-Content -Path $global:ArquivoLog -Value $linha

    Write-Host $linha
}

# =========================
# NOME CLIENTE
# =========================
do {
    $cliente = Read-Host "Digite o nome do Cliente"
} while ([string]::IsNullOrWhiteSpace($cliente))

# Remove caracteres inválidos
$cliente = $cliente -replace '[\\/:*?"<>|]', ''

# =========================
# DATA
# =========================
$data = Get-Date -Format "dd-MM-yy"

# =========================
# DESKTOP
# =========================
$desktop = [Environment]::GetFolderPath("Desktop")

# =========================
# PASTA PRINCIPAL
# =========================
$nomePastaPrincipal = "Checklist $cliente $data"

$pastaPrincipal = Join-Path $desktop $nomePastaPrincipal

# Criar pasta principal
New-Item -Path $pastaPrincipal -ItemType Directory -Force | Out-Null

# =========================
# PASTAS FIXAS
# =========================
$pastaServidor = Join-Path $pastaPrincipal "Servidor"
$pastaInternet = Join-Path $pastaPrincipal "Internet e Switch"

New-Item -Path $pastaServidor -ItemType Directory -Force | Out-Null
New-Item -Path $pastaInternet -ItemType Directory -Force | Out-Null

# =========================
# NOME DO LOG
# =========================
$dataHoraLog = Get-Date -Format "dd-MM-yy_HH-mm-ss"

$nomeLog = "LOG_Checklist_$dataHoraLog.txt"

$global:ArquivoLog = Join-Path $pastaPrincipal $nomeLog

# Criar arquivo log
New-Item -Path $global:ArquivoLog -ItemType File -Force | Out-Null

# =========================
# INICIO LOG
# =========================
Escrever-Log "=========================================="
Escrever-Log "INICIO DO PROCESSO"
Escrever-Log "Cliente: $cliente"
Escrever-Log "Pasta principal: $nomePastaPrincipal"
Escrever-Log "Local: $pastaPrincipal"
Escrever-Log "Log: $nomeLog"
Escrever-Log "=========================================="

Escrever-Log "Pasta fixa criada: Servidor"
Escrever-Log "Pasta fixa criada: Internet e Switch"

Write-Host ""

# =========================
# QUANTIDADE LOJAS
# =========================
do {
    $qtdLojas = Read-Host "Quantas lojas existem?"
} while (-not ($qtdLojas -match '^\d+$'))

$qtdLojas = [int]$qtdLojas

Escrever-Log "Quantidade de lojas: $qtdLojas"

Write-Host ""

# =====================================================
# LOOP LOJAS
# =====================================================
for ($i = 1; $i -le $qtdLojas; $i++) {

    # =========================
    # NOME LOJA
    # =========================
    if ($i -eq 1) {
        $nomeLoja = "Matriz"
    }
    else {
        $numeroFilial = "{0:D2}" -f ($i - 1)
        $nomeLoja = "Filial $numeroFilial"
    }

    # =========================
    # CRIA PASTA LOJA
    # =========================
    $pastaLoja = Join-Path $pastaPrincipal $nomeLoja

    New-Item -Path $pastaLoja -ItemType Directory -Force | Out-Null

    Escrever-Log ""
    Escrever-Log "=========================================="
    Escrever-Log "LOJA CRIADA: $nomeLoja"
    Escrever-Log "Pasta: $pastaLoja"
    Escrever-Log "=========================================="

    # =========================
    # QUANTIDADE CAIXAS
    # =========================
    do {
        $qtdCaixas = Read-Host "Quantos caixas existem em $nomeLoja"
    } while (-not ($qtdCaixas -match '^\d+$'))

    $qtdCaixas = [int]$qtdCaixas

    Escrever-Log "Quantidade de caixas em $nomeLoja : $qtdCaixas"

    # =====================================================
    # LOOP CAIXAS
    # =====================================================
    for ($c = 1; $c -le $qtdCaixas; $c++) {

        $numeroCaixa = "{0:D2}" -f $c

        $nomeCaixa = "Caixa $numeroCaixa"

        # Caminho caixa
        $pastaCaixa = Join-Path $pastaLoja $nomeCaixa

        # Criar pasta caixa
        New-Item -Path $pastaCaixa -ItemType Directory -Force | Out-Null

        Escrever-Log "   -> Caixa criado: $nomeCaixa"
        Escrever-Log "      Caminho: $pastaCaixa"
    }

    # =========================
    # QUANTIDADE RETAGUARDAS
    # =========================
    do {
        $qtdRetaguardas = Read-Host "Quantas retaguardas existem em $nomeLoja"
    } while (-not ($qtdRetaguardas -match '^\d+$'))

    $qtdRetaguardas = [int]$qtdRetaguardas

    Escrever-Log "Quantidade de retaguardas em $nomeLoja : $qtdRetaguardas"

    # =====================================================
    # LOOP RETAGUARDAS
    # =====================================================
    for ($r = 1; $r -le $qtdRetaguardas; $r++) {

        $numeroRetaguarda = "{0:D2}" -f $r

        $nomeRetaguarda = "Retaguarda $numeroRetaguarda"

        # Caminho retaguarda
        $pastaRetaguarda = Join-Path $pastaLoja $nomeRetaguarda

        # Criar pasta retaguarda
        New-Item -Path $pastaRetaguarda -ItemType Directory -Force | Out-Null

        Escrever-Log "   -> Retaguarda criada: $nomeRetaguarda"
        Escrever-Log "      Caminho: $pastaRetaguarda"
    }

    Write-Host ""
}

# =====================================================
# ESTRUTURA COMPLETA
# =====================================================
Escrever-Log ""
Escrever-Log "=========================================="
Escrever-Log "ESTRUTURA COMPLETA DAS PASTAS"
Escrever-Log "=========================================="

$arvore = tree $pastaPrincipal /F

foreach ($linha in $arvore) {
    Add-Content -Path $global:ArquivoLog -Value $linha
}

# =====================================================
# FINAL
# =====================================================
Escrever-Log ""
Escrever-Log "=========================================="
Escrever-Log "PROCESSO FINALIZADO COM SUCESSO"
Escrever-Log "=========================================="

Write-Host ""
Write-Host "==========================================" -ForegroundColor Green
Write-Host "   CHECKLIST CRIADO COM SUCESSO"
Write-Host "==========================================" -ForegroundColor Green
Write-Host ""

Write-Host "Pasta criada em:" -ForegroundColor Yellow
Write-Host $pastaPrincipal
Write-Host ""

Write-Host "Log salvo em:" -ForegroundColor Yellow
Write-Host $global:ArquivoLog
Write-Host ""

# Abrir pasta principal
Start-Process $pastaPrincipal

Write-Host ""
Write-Host "Pressione qualquer tecla para encerrar..." -ForegroundColor Cyan

# Aguarda tecla
$null = $Host.UI.RawUI.ReadKey("NoEcho,IncludeKeyDown")

# Fecha PowerShell
exit
