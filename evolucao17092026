$netbios = $env:COMPUTERNAME

# ================= MONTAGEM DA SAÍDA =================
# CPU
$cpuLinha = "$cpu`n$cores cores / $threads threads"
$cpuExtras = @()
if ($speccy.Available -and $speccy.MachineMatch -ne $false) {
    if ($speccy.CpuCodename) { $cpuExtras += $speccy.CpuCodename }
    if ($speccy.CpuPackage)  { $cpuExtras += $speccy.CpuPackage }
    if ($speccy.CpuTemp)     { $cpuExtras += "Temp: $($speccy.CpuTemp)" }
}
if ($cpuExtras.Count -gt 0) { $cpuLinha += "`n(" + ($cpuExtras -join " | ") + ")" }

# RAM — apenas tipo e frequência (sem canais nem timings)
$ramTipoFinal = if ($speccy.Available -and $speccy.MachineMatch -ne $false -and $speccy.RamType) { $speccy.RamType } else { $ramType }
$ramFreqFinal = if ($speccy.Available -and $speccy.MachineMatch -ne $false -and $speccy.RamFreq) { $speccy.RamFreq } else { "$ramSpeed MHz" }

$ramLinha = "$totalRam ($ramTipoFinal $ramFreqFinal)"

# ================= FRASE DE FONTE =================
$speccyFoiUsado = ($speccy.Available -and $speccy.MachineMatch -ne $false)

if ($speccyFoiUsado) {
    $fraseFonte = "(Informações complementadas pelo Speccy)"
} else {
    $fraseFonte = "(Relatório gerado apenas com dados do WMI)"
}

# ================= MONTAGEM DO RELATÓRIO (linha a linha) =================
$linhas = New-Object System.Collections.Generic.List[string]

$linhas.Add("Sistema Operacional: $os")
$linhas.Add("")
$linhas.Add("Processador: $cpuLinha")
$linhas.Add("")
$linhas.Add("Memória Total: $ramLinha")
$linhas.Add("")
$linhas.Add("Armazenamento:")
$linhas.Add($diskLine)
$linhas.Add("")
$linhas.Add("Rede:")
$linhas.Add($redeInfo)
$linhas.Add("")

if ($isCaixa) {
    $linhas.Add("Fonte: $($perifericos.Fonte)")
    $linhas.Add("Balança: $($perifericos.Balanca)")
    $linhas.Add("Impressora: $($perifericos.Impressora)")
    $linhas.Add("Leitor código de barras: $($perifericos.Leitor)")
    $linhas.Add("PinPad: $($perifericos.PinPad)")
    $linhas.Add("Teclado: $($perifericos.Teclado)")
    $linhas.Add("")
}

$linhas.Add("Placa Mãe:")
$linhas.Add($mbInfo)
$linhas.Add("")
$linhas.Add("NetBIOS Name: $netbios")
$linhas.Add("")
$linhas.Add("IP:")
$linhas.Add($ip)
$linhas.Add("")
$linhas.Add($dataHora)
$linhas.Add("")
$linhas.Add($fraseFonte)

$output = $linhas -join "`r`n"

# ================= SALVAR =================
$desktop = [Environment]::GetFolderPath("Desktop")
$path = "$desktop\$netbios $dataArquivo.txt"

$output | Out-File $path -Encoding UTF8

Write-Host ""
Write-Host "Relatório salvo em: $path" -ForegroundColor Green
