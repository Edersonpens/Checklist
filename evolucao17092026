function Show-Menu {
    param(
        [string]$Titulo,
        [string[]]$Opcoes
    )
    Write-Host ""
    Write-Host "================================================" -ForegroundColor Cyan
    Write-Host " $Titulo" -ForegroundColor Cyan
    Write-Host "================================================" -ForegroundColor Cyan
    for ($i = 0; $i -lt $Opcoes.Count; $i++) {
        Write-Host ("  [{0}] {1}" -f ($i + 1), $Opcoes[$i])
    }
    Write-Host "================================================" -ForegroundColor Cyan
}

function Read-OpcaoMenu {
    param(
        [string[]]$Opcoes,
        [string]$PromptExtra = "Opção"
    )
    $max = $Opcoes.Count
    do {
        $resp = Read-Host $PromptExtra
        $num = 0
        $valido = [int]::TryParse($resp, [ref]$num) -and $num -ge 1 -and $num -le $max
    } while (-not $valido)
    return ($num - 1)
}

